{
  "name": "telegram-educational-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Telegram educational bot foundation built with Node.js, TypeScript, Telegraf, and Supabase.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "set-webhook": "tsx src/scripts/set-webhook.ts",
    "delete-webhook": "tsx src/scripts/set-webhook.ts --delete",
    "typecheck": "tsc --noEmit",
    "typecheck:vercel": "tsc --noEmit -p tsconfig.vercel.json"
  },
  "keywords": [
    "telegram",
    "bot",
    "supabase",
    "telegraf",
    "education"
  ],
  "license": "MIT",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fuse.js": "^7.0.0",
    "telegraf": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.1",
    "@vercel/node": "^23.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
